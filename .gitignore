# credentials — never commit
.secrets/

# bulky pipeline checkpoints (re-created by scripts/fetch_data.py; compressed
# snapshots live in data/checkpoints/ which IS committed for resumability)
data/raw/
data/processed/
logs/

__pycache__/
*.pyc
.venv/
data/mythic_runs*.csv
# transient: export() writes here then os.replace()s it into place, so a run
# that happens to be mid-export leaves this behind for a moment
data/*.csv.gz.tmp
data/*.json.tmp
node_modules/
package-lock.json
package.json
data/.build_stamp
data/*.jsonl.gz.tmp

# per-parse stats sidecar: rebuilt from the gear journal every run, never committed
site/stats.json.gz
docs/stats.json.gz

# builds sidecar: same — rebuilt every run from the journal + name caches
site/builds.json.gz
docs/builds.json.gz

# talent-tree document: same — rebuilt every run from the trait caches
site/talents.json.gz
docs/talents.json.gz

# agent scratch: verification agents serve site/ on ad-hoc ports and redirect
# server output beside the repo root. Transient, never part of a build.
srv*.log
*.serve.log

# LLM export: built daily by .github/workflows/llms.yml, published as the
# `llms` Release asset and unpacked into site/ by the refresh. Untracked
# since 2026-09-02 -- it was ~20 MB of regenerated files per day of history.
site/llms/
site/llms.txt
docs/llms/
docs/llms.txt
# the build stamp that rides in the tarball next to llms.txt
site/llms.built
docs/llms.built
